{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/avisos.json' ':(exclude)data/stock.json' ':(exclude)data/gestion.json'",
  "functions": {
    "api/gestion.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
